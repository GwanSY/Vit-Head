+TEST_P(PackLWEsTest, RuntimeContextsBitwise) {
+  // Match the deployed FM64 matrix-OLE contexts: 3 coefficient moduli in
+  // the computation context, special-prime Galois context, drop to 2 for KS.
+  seal::EncryptionParameters parms(seal::scheme_type::ckks);
+  parms.set_poly_modulus_degree(poly_N);
+  parms.set_coeff_modulus(seal::CoeffModulus::Create(poly_N,{59,55,49}));
+  parms.set_use_special_prime(false);
+  seal::SEALContext work(parms,true,seal::sec_level_type::none);
+  seal::KeyGenerator keygen(work);
+  auto sk=keygen.secret_key();
+  parms.set_use_special_prime(true);
+  seal::SEALContext gk_context(parms,true,seal::sec_level_type::none);
+  GaloisKeys keys;
+  GenerateGaloisKeyForPacking(gk_context,sk,false,&keys);
+  ModulusSwitchHelper msh(work,64);
+  VectorEncoder encoder(work,msh);
+  seal::Encryptor encryptor(work,sk);
+  const size_t gap=std::get<1>(GetParam())/32;
+  PackingHelper ph(gap,keys,gk_context,work);
+  for (bool ntt : {false,true}) {
+    for (size_t count : {gap,2*gap+5}) {
+      std::vector<RLWECt> a(count);
+      for (auto& ct : a) {
+        RLWEPt pt;
+        encoder.Forward(ring_rand(FM64,{poly_N}),&pt,true);
+        NttInplace(pt,work);
+        encryptor.encrypt_symmetric(pt,ct);
+        if (!ntt) InvNttInplace(ct,work);
+      }
+      auto b=a;
+      const size_t groups=(count+gap-1)/gap;
+      std::vector<RLWECt> old(groups),opt(groups);
+      for (size_t g=0;g<groups;++g) {
+        ph.PackingWithModulusDrop(absl::MakeSpan(a).subspan(g*gap,std::min(gap,count-g*gap)),old[g]);
+      }
+      ph.PackingWithModulusDropBatch(absl::MakeSpan(b),absl::MakeSpan(opt));
+      for (size_t g=0;g<groups;++g) {
+        ASSERT_EQ(old[g].parms_id(),opt[g].parms_id());
+        ASSERT_EQ(old[g].coeff_modulus_size(),2UL);
+        const size_t words=old[g].size()*poly_N*old[g].coeff_modulus_size();
+        ASSERT_TRUE(std::equal(old[g].data(),old[g].data()+words,opt[g].data()));
+      }
+    }
+  }
+  std::vector<RLWECt> aliased(gap);
+  EXPECT_ANY_THROW(ph.PackingWithModulusDropBatch(absl::MakeSpan(aliased),absl::MakeSpan(aliased).subspan(0,1)));
+}
