+TEST_P(PackLWEsTest, BatchedRLWEBitwise) {
+  const size_t gap = std::get<1>(GetParam())/32;
+  seal::Encryptor encryptor(*N_context_, *N_rlwe_sk_);
+  PackingHelper ph(gap, *galois_, *N_context_, *N_context_);
+  // Exercise single ciphertext, full groups, incomplete groups, and both
+  // coefficient/NTT inputs. Same ciphertexts, no fresh encryption comparison.
+  for (bool ntt : {false,true}) {
+    for (size_t count : {1UL,gap-1,gap,2*gap+5}) {
+      std::vector<RLWECt> original(count);
+      for (auto& ct : original) {
+        RLWEPt pt;
+        N_encoder_->Forward(ring_rand(FM64,{poly_N}), &pt, true);
+        NttInplace(pt, *N_context_);
+        encryptor.encrypt_symmetric(pt, ct);
+        if (!ntt) InvNttInplace(ct, *N_context_);
+      }
+      auto optimized = original;
+      const size_t groups = (count+gap-1)/gap;
+      std::vector<RLWECt> a(groups),b(groups);
+      ResetBumblebeeMetrics();
+      for (size_t group=0;group<groups;++group) {
+        const size_t begin=group*gap, n=std::min(gap,count-begin);
+        ph.PackingWithModulusDrop(absl::MakeSpan(original).subspan(begin,n),a[group]);
+      }
+      const auto old_he_calls=GetBumblebeeMetrics().he.calls;
+      ResetBumblebeeMetrics();
+      ph.PackingWithModulusDropBatch(absl::MakeSpan(optimized),absl::MakeSpan(b));
+      EXPECT_EQ(GetBumblebeeMetrics().he.calls,old_he_calls);
+      for (size_t group=0;group<groups;++group) {
+        ASSERT_EQ(a[group].size(),b[group].size());
+        ASSERT_EQ(a[group].parms_id(),b[group].parms_id());
+        ASSERT_EQ(a[group].is_ntt_form(),b[group].is_ntt_form());
+        ASSERT_EQ(a[group].scale(),b[group].scale());
+        const size_t words=a[group].size()*a[group].poly_modulus_degree()*a[group].coeff_modulus_size();
+        ASSERT_TRUE(std::equal(a[group].data(),a[group].data()+words,b[group].data()));
+      }
+    }
+  }
+}
