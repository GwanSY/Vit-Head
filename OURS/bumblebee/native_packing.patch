+void PackingHelper::PackingWithModulusDropBatch(
+    absl::Span<RLWECt> rlwes, absl::Span<RLWECt> packed) const {
+  SPU_ENFORCE(!evaluator_->using_gpu(), "CPU packing-tree batching only");
+  SPU_ENFORCE(!rlwes.empty());
+  const int64_t groups = (rlwes.size() + gap_ - 1) / gap_;
+  SPU_ENFORCE_EQ(packed.size(), static_cast<size_t>(groups));
+  // Separate output storage is essential: compacting each result directly to
+  // rlwes[group] while other groups read their inputs is a data race.
+  const auto input_begin = reinterpret_cast<uintptr_t>(rlwes.data());
+  const auto input_end = input_begin + rlwes.size()*sizeof(RLWECt);
+  const auto output_begin = reinterpret_cast<uintptr_t>(packed.data());
+  const auto output_end = output_begin + packed.size()*sizeof(RLWECt);
+  SPU_ENFORCE(output_end <= input_begin || output_begin >= input_end,
+              "packing outputs must not alias inputs");
+  const auto pid = rlwes[0].parms_id();
+  for (const auto& ct : rlwes) {
+    if (ct.size() == 0) continue;
+    SPU_ENFORCE_EQ(ct.size(), 2UL);
+    SPU_ENFORCE(ct.parms_id() == pid);
+  }
+  const int64_t poly_degree =
+      context_.first_context_data()->parms().poly_modulus_degree();
+  const size_t modulus_for_keyswitch =
+      gk_context_.first_context_data()->chain_index() + 1;
+  yacl::parallel_for(0, rlwes.size(), [&](int64_t bgn, int64_t end) {
+    for (int64_t i = bgn; i < end; ++i) {
+      InvNttInplace(rlwes[i], context_, true);
+      MultiplyFixedScalarInplace(rlwes[i]);
+      ModulusSwtichInplace(rlwes[i], modulus_for_keyswitch, context_);
+      rlwes[i].parms_id() = gk_context_.first_parms_id();
+    }
+  });
+  auto& evaluator = *evaluator_;
+  const int64_t logn = absl::bit_width(gap_) - 1;
+  for (int64_t k = logn; k >= 1; --k) {
+    const int64_t h = 1LL << (k - 1);
+    // The parallel_for barrier preserves dependencies between tree levels.
+    // No nested parallelism: even the last level has one task per group.
+    yacl::parallel_for(0, groups * h, [&](int64_t bgn, int64_t end) {
+      for (int64_t job = bgn; job < end; ++job) {
+        const int64_t group = job / h, i = job % h;
+        const int64_t start = group * gap_;
+        const int64_t count = std::min<int64_t>(gap_, rlwes.size()-start);
+        RLWECt dummy;
+        RLWECt& ct_even = i < count ? rlwes[start+i] : dummy;
+        RLWECt& ct_odd = i+h < count ? rlwes[start+i+h] : dummy;
+        const bool is_odd_empty = ct_odd.size() == 0;
+        const bool is_even_empty = ct_even.size() == 0;
+        if (is_even_empty && is_odd_empty) {
+          ct_even.release();
+          continue;
+        }
+        NegacyclicRightShiftInplace(ct_odd, h, gk_context_);
+        if (!is_even_empty) {
+          seal::Ciphertext tmp = ct_even;
+          if (!is_odd_empty) {
+            CATCH_SEAL_ERROR(evaluator.sub_inplace(ct_even, ct_odd));
+            CATCH_SEAL_ERROR(evaluator.add_inplace(tmp, ct_odd));
+          }
+          CATCH_SEAL_ERROR(evaluator.apply_galois_inplace(
+              ct_even, poly_degree/h+1, galois_keys_));
+          CATCH_SEAL_ERROR(evaluator.add_inplace(ct_even, tmp));
+        } else {
+          evaluator.negate(ct_odd, ct_even);
+          CATCH_SEAL_ERROR(evaluator.apply_galois_inplace(
+              ct_even, poly_degree/h+1, galois_keys_));
+          CATCH_SEAL_ERROR(evaluator.add_inplace(ct_even, ct_odd));
+        }
+      }
+    });
+  }
+  auto final_context = context_.first_context_data();
+  while (final_context->chain_index()+1 > modulus_for_keyswitch) {
+    final_context = final_context->next_context_data();
+  }
+  for (int64_t group=0; group<groups; ++group) {
+    SPU_ENFORCE(rlwes[group*gap_].size()>0);
+    packed[group] = std::move(rlwes[group*gap_]);
+    packed[group].parms_id() = final_context->parms_id();
+  }
 }
 
